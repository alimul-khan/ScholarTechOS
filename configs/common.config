# Shared by every board. Applied after the board's Buildroot defconfig, then the board fragment.
BR2_TARGET_GENERIC_HOSTNAME="scholartech"
BR2_TARGET_GENERIC_ISSUE="Welcome to ScholarTechOS"
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SCHOLARTECH_PATH)/board/common/overlay"
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
# Boot look: no early splash program; the STOS animation (overlay /usr/share/scholartech/splash.gif)
# is played by the player when it starts.
# Python
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_ZLIB=y
# Graphics: v3d = Pi 4 GPU, vc4 = Zero 2 W / Pi 3 GPU
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# Fonts and certificates (the web browser for the prayer display is in configs/prayer.config)
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_CA_CERTIFICATES=y
# Audio (ALSA) and standalone media player
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_MPV=y
BR2_PACKAGE_FFMPEG=y
# First-time Wi-Fi setup hotspot (netsetup.py) and on-device QR codes
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_PYTHON_SEGNO=y
# scholartech.local name on the network
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
# Time zones (prayer times, local clock)
BR2_TARGET_TZ_INFO=y
# Networking
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
