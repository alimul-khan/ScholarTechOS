# Applied on top of Buildroot's raspberrypi4_64_defconfig
BR2_TARGET_GENERIC_HOSTNAME="scholartech"
BR2_TARGET_GENERIC_ISSUE="Welcome to ScholarTechOS"
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SCHOLARTECH_PATH)/board/rpi4/overlay"
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_SCHOLARTECH_PATH)/board/rpi4/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_SCHOLARTECH_PATH)/board/rpi4/cmdline.txt"
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
# Boot splash (logo from board/rpi4/logo.png)
BR2_PACKAGE_PSPLASH=y
BR2_PACKAGE_PSPLASH_IMAGE="$(BR2_EXTERNAL_SCHOLARTECH_PATH)/board/rpi4/logo.png"
# BR2_PACKAGE_PSPLASH_PROGRESS_BAR is not set
# BR2_PACKAGE_PSPLASH_STARTUP_MSG is not set
# Python
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
# Graphics (kiosk browser is optional, see board/rpi4/optional-kiosk)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_CA_CERTIFICATES=y
# Images + video
BR2_PACKAGE_MPV=y
BR2_PACKAGE_FFMPEG=y
# Networking
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
