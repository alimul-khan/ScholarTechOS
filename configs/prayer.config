# Prayer display only: the WPE WebKit kiosk browser (cog) and video in web pages.
# Not part of the advertisement image (its player is mpv). Applied after common.config + <board>.config.
# Heavy: WebKit takes hours to compile; build it with the cache that survives cancelled builds.
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_WPEWEBKIT_MULTIMEDIA=y
BR2_PACKAGE_COG=y
BR2_PACKAGE_COG_PLATFORM_DRM=y
# Video in web pages: MP4 demux, H.264 parser, hardware decoder (V4L2), AAC audio (libav)
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ISOMP4=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
BR2_PACKAGE_GST1_LIBAV=y
# Keyboard-layout data: cage and cog refuse to start without it, even with no keyboard attached
BR2_PACKAGE_XKEYBOARD_CONFIG=y
# Cage: the small compositor the browser runs in (the tested way to show pages fullscreen)
BR2_PACKAGE_CAGE=y
# The prayer display app (apps/prayer, from display_template) and its server
BR2_PACKAGE_SCHOLARTECH_PRAYER=y
# Local clock for prayer times; change here (or on the device: /etc/localtime) for another city
BR2_TARGET_LOCALTIME="America/Regina"
