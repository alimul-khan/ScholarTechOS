#!/bin/sh
# Applies optional settings found on the boot partition (editable from any computer):
#   wifi.txt         SSID=..., PASSWORD=..., COUNTRY=XX   (PASSWORD empty = open network)
#   authorized_keys  SSH public key(s) allowed to log in as root
#   kiosk.txt        URL=https://...   (page the kiosk browser shows)
#   server.txt       SERVER=https://... (website the screen links to; changing it re-registers)
MNT=/run/bootcfg
mkdir -p "$MNT"
modprobe vfat 2>/dev/null
mount -t vfat -o ro /dev/mmcblk0p1 "$MNT" 2>/dev/null || exit 0

if [ -f "$MNT/authorized_keys" ]; then
    mkdir -p /root/.ssh && chmod 700 /root/.ssh
    tr -d '\r' < "$MNT/authorized_keys" > /root/.ssh/authorized_keys
    chmod 600 /root/.ssh/authorized_keys
fi

if [ -f "$MNT/wifi.txt" ]; then
    get() { sed -n "s/^$1=//p" "$MNT/wifi.txt" | head -n 1 | tr -d '\r'; }
    SSID=$(get SSID); PASS=$(get PASSWORD); COUNTRY=$(get COUNTRY)
    if [ -n "$SSID" ]; then
        mkdir -p /etc/wpa_supplicant
        CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
        {
            [ -n "$COUNTRY" ] && echo "country=$COUNTRY"
            if [ -n "$PASS" ]; then
                # key_mgmt/ieee80211w: many current routers reject the Pi without these
                wpa_passphrase "$SSID" "$PASS" | grep -v '^[[:space:]]*#psk' |
                    sed '/ssid=/a\
key_mgmt=WPA-PSK WPA-PSK-SHA256\
ieee80211w=1'
            else
                printf 'network={\n\tssid="%s"\nkey_mgmt=NONE\n}\n' "$SSID"
            fi
        } > "$CONF"
        chmod 600 "$CONF"
        rfkill unblock wifi 2>/dev/null
        systemctl enable wpa_supplicant@wlan0.service 2>/dev/null
        systemctl start --no-block wpa_supplicant@wlan0.service
    fi
fi

if [ -f "$MNT/server.txt" ]; then
    NEW=$(sed -n 's/^SERVER=//p' "$MNT/server.txt" | head -n 1 | tr -d '\r')
    OLD=$(sed -n 's/^SERVER=//p' /etc/scholartech/cloud.conf 2>/dev/null)
    if [ -n "$NEW" ] && [ "$NEW" != "$OLD" ]; then
        echo "SERVER=$NEW" > /etc/scholartech/cloud.conf   # new website: register again there
        chmod 600 /etc/scholartech/cloud.conf
    fi
fi

if [ -f "$MNT/kiosk.txt" ]; then
    URL=$(sed -n 's/^URL=//p' "$MNT/kiosk.txt" | head -n 1 | tr -d '\r')
    [ -n "$URL" ] && echo "URL=$URL" > /etc/scholartech/kiosk.conf
fi

umount "$MNT" 2>/dev/null
exit 0
