[Unit]
Description=ScholarTechOS kiosk browser
After=systemd-user-sessions.service psplash-start.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
EnvironmentFile=/etc/scholartech/kiosk.conf
Environment=XDG_RUNTIME_DIR=/run/kiosk LIBSEAT_BACKEND=builtin WLR_LIBINPUT_NO_DEVICES=1
RuntimeDirectory=kiosk
RuntimeDirectoryMode=0700
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
ExecStartPre=-/usr/bin/psplash-write QUIT
ExecStart=/usr/bin/cage -s -- /usr/bin/cog --platform=wl ${URL}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
